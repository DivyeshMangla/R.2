{
  "name": "@robot-arena/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "test:aim": "tsx src/test/aimHarness.ts",
    "test:driving": "tsx src/test/drivingHarness.ts",
    "test:drift": "node --import tsx src/test/driftHarness.ts",
    "test:lobby": "tsx src/test/lobbyHarness.ts",
    "test:bots": "node --import tsx src/test/botHarness.ts",
    "test:maps": "node --import tsx src/test/mapHarness.ts",
    "test:camera": "node --import tsx src/test/cameraHarness.ts",
    "test:network": "tsx src/test/networkHarness.ts",
    "test:lethality": "node --import tsx src/test/lethalityHarness.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.0",
    "@colyseus/ws-transport": "^0.18.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@robot-arena/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0"
  }
}
