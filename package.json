{
  "name": "robot-arena",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client",
    "typecheck": "tsc -p shared --noEmit && tsc -p server --noEmit && tsc -p client --noEmit",
    "test:aim": "npm run test:aim -w server",
    "test:driving": "npm run test:driving -w server",
    "test:lobby": "npm run test:lobby -w server",
    "test:bots": "npm run test:bots -w server",
    "test:maps": "npm run test:maps -w server",
    "test:network": "npm run test:network -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3"
  }
}
